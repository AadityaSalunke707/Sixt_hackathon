# Keep this file on the backend only. Never put the LLM key in VITE_* variables.
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=claude-haiku-4.5
JUDGE_LLM_MAX_TOKENS=256
JUDGE_LLM_TIMEOUT=60
JUDGE_LLM_MAX_RETRIES=6

# Comma-separated local frontend origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
